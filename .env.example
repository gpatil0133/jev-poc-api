# ── Backend switch ───────────────────────────────────────────────────────
# laya | jev. Read once at start-up: change it and restart the gateway.
# jev sends text to the external TypeSafe API and is billed per input token.
BACKEND=laya

# ── Jev backend (TypeSafe API; same names as typesafe-sdk) ───────────────
TYPESAFE_API_KEY=
# Optional overrides:
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# Jev has no batch route; a batch is this many single calls at a time.
# JEV_MAX_CONCURRENT=8

# ── Laya backend (stock laya-serve on the GPU box) ───────────────────────
LAYA_BASE_URL=http://gpu-box:8000
LAYA_API_KEY=
# auto | english | multilingual  ("auto" lets laya-serve route by language)
LAYA_DEFAULT_MODEL=auto

# ── Calling patterns ─────────────────────────────────────────────────────
LIVE_TIMEOUT_MS=300
# Live calls waiting on Laya at once; the rest fall back immediately (0 = no cap).
# Laya runs one forward pass at a time, so size this as budget / per-call latency.
LIVE_MAX_INFLIGHT=4
BATCH_MAX_ITEMS=256
BATCH_TIMEOUT_S=60

# ── Banding defaults (templates and callers can override) ────────────────
THRESHOLD_ACT=0.85
THRESHOLD_SUGGEST=0.60

# ── Auth (RS256, same keypair as Research.Auth) ──────────────────────────
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# DEV ONLY: treat the Bearer value as a raw corp_no. Refused unless APP_ENV is dev-like.
DEV_AUTH_BYPASS=false
APP_ENV=dev

# ── Storage / logging ────────────────────────────────────────────────────
DATA_DIR=./data
LOG_DIR=./logs
# Off by default: the decision log stores a text hash, not the comment.
LOG_TEXT=false
CACHE_MAX_ENTRIES=200000

# ── Sogo-lite mock (ui/) ─────────────────────────────────────────────────
# The mock calls this gateway, so it uses whichever BACKEND is set above.
# Leave the URL unset for the gateway started from this repo on port 8010.
# SOGO_LITE_GATEWAY_URL=http://127.0.0.1:8010
# A gateway JWT, or a corp_no when DEV_AUTH_BYPASS=true.
SOGO_LITE_GATEWAY_TOKEN=
