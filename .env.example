# ── Laya backend (stock laya-serve on the GPU box) ───────────────────────
LAYA_BASE_URL=http://gpu-box:8000
LAYA_API_KEY=
# auto | english | multilingual  ("auto" lets laya-serve route by language)
LAYA_DEFAULT_MODEL=auto

# ── Calling patterns ─────────────────────────────────────────────────────
LIVE_TIMEOUT_MS=300
# Live calls waiting on Laya at once; the rest fall back immediately (0 = no cap).
# Laya runs one forward pass at a time, so size this as budget / per-call latency.
LIVE_MAX_INFLIGHT=4
BATCH_MAX_ITEMS=256
BATCH_TIMEOUT_S=60

# ── Banding defaults (templates and callers can override) ────────────────
THRESHOLD_ACT=0.85
THRESHOLD_SUGGEST=0.60

# ── Auth (RS256, same keypair as Research.Auth) ──────────────────────────
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# DEV ONLY: treat the Bearer value as a raw corp_no. Refused unless APP_ENV is dev-like.
DEV_AUTH_BYPASS=false
APP_ENV=dev

# ── Storage / logging ────────────────────────────────────────────────────
DATA_DIR=./data
LOG_DIR=./logs
# Off by default: the decision log stores a text hash, not the comment.
LOG_TEXT=false
CACHE_MAX_ENTRIES=200000
